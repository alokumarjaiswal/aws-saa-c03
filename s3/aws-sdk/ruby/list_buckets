#! /usr/bin/env ruby
# frozen_string_literal: true
#
# list_buckets
#
# PURPOSE: List the N most recently created S3 buckets in this AWS account
#          (default N=5). Buckets are account-wide/global, not limited to
#          AWS_DEFAULT_REGION — see note on bucket_region below.
# USAGE:   bundle exec ruby list_buckets [-n N] [-v]

require 'bundler/setup'
require 'aws-sdk-s3'
require 'optparse'
require 'logger'

LOG = Logger.new($stdout).tap { |l| l.level = Logger::INFO }

def s3_client
  @s3_client ||= Aws::S3::Client.new
end

def parse_options(argv)
  options = { count: 5, verbose: false }

  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: list_buckets [options]'
    opts.on('-n', '--count N', Integer, 'Number of buckets to show (default: 5)') { |v| options[:count] = v }
    opts.on('-v', '--verbose', 'Enable verbose logging') { options[:verbose] = true }
    opts.on('-h', '--help', 'Show this help') { puts opts; exit 0 }
  end

  parser.parse!(argv)
  LOG.level = Logger::DEBUG if options[:verbose]
  options
end

def print_table(headers, rows)
  widths = headers.each_index.map { |i| ([headers[i].length] + rows.map { |r| r[i].to_s.length }).max }
  line = ->(cells) { cells.each_with_index.map { |c, i| c.to_s.ljust(widths[i]) }.join('  ') }

  puts line.call(headers)
  puts widths.map { |w| '-' * w }.join('  ')
  rows.each { |r| puts line.call(r) }
end

def run(options)
  # ListBuckets omits bucket_region entirely unless the request includes at
  # least one parameter (this is documented AWS API behavior, not a bug).
  # max_buckets: 10_000 is the API's own page cap, so this still fetches
  # everything in one call while making region data show up.
  buckets = s3_client.list_buckets(max_buckets: 10_000).buckets

  LOG.debug("Fetched #{buckets.size} total bucket(s) from account.")
  recent = buckets.sort_by(&:creation_date).reverse.first(options[:count])
  LOG.debug("Showing #{recent.size} of #{buckets.size} (limited by --count #{options[:count]}).")

  LOG.info("#{recent.size} most recently created bucket(s):")
  rows = recent.each_with_index.map do |bucket, i|
    [i + 1, bucket.name, bucket.bucket_region || 'unknown', bucket.creation_date]
  end
  print_table(['#', 'Bucket', 'Region', 'Created'], rows)
end

def main
  options = parse_options(ARGV)
  run(options)
end

main if __FILE__ == $PROGRAM_NAME