#! /usr/bin/env bash
#
# deploy — generic CloudFormation deploy script, works with any template.
# Previews changes via a CloudFormation change set before applying them.
#
# Usage:
#   ./deploy <template-file> <stack-name> [ParamKey=Value ...] [--yes]
#
# Examples:
#   ./deploy templates/bucket-secure.yaml secure-bucket-stack BucketName=my-unique-secure-bucket-2026
#   ./deploy templates/bucket-website.yaml website-stack BucketName=my-unique-site-2026 --yes
#   ./deploy.sh templates/bucket-website.yaml website-stack BucketName=my-unique-site-2026 IndexDocument=home.html
#
# --yes skips the confirmation prompt and applies the change set immediately

export PS4='+ ${BASH_SOURCE}:${LINENO}: '
# set -xeuo pipefail
set -euo pipefail
export AWS_PAGER=""

[[ $# -lt 2 ]] && { echo "Usage: $0 <template-file> <stack-name> [ParamKey=Value ...] [--yes]" >&2; exit 1; }

template_file="$1"
stack_name="$2"
shift 2

command -v aws >/dev/null 2>&1 || { echo "aws CLI not found" >&2; exit 1; }

auto_approve=false
param_args=()
for arg in "$@"; do
  if [[ "$arg" == "--yes" ]]; then
    auto_approve=true
  else
    key="${arg%%=*}"
    val="${arg#*=}"
    param_args+=("ParameterKey=${key},ParameterValue=${val}")
  fi
done

[[ -f "$template_file" ]] || { echo "ERROR: template file '$template_file' not found" >&2; exit 1; }

echo "Validating template: $template_file"
if ! error_output="$(aws cloudformation validate-template --template-body "file://${template_file}" 2>&1)"; then
  error_output="$(echo "$error_output" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
  echo "ERROR: template validation failed" >&2
  echo "Reason: $error_output" >&2
  exit 1
fi

# A new stack needs ChangeSetType=CREATE; an existing one needs UPDATE.
# describe-stacks fails (non-zero exit) if the stack doesn't exist yet.
if aws cloudformation describe-stacks --stack-name "$stack_name" >/dev/null 2>&1; then
  change_set_type="UPDATE"
else
  change_set_type="CREATE"
fi

change_set_name="preview-$(date +%Y%m%d%H%M%S)"

echo "Creating change set '$change_set_name' ($change_set_type) for stack '$stack_name'..."

create_args=(
  --stack-name "$stack_name"
  --change-set-name "$change_set_name"
  --change-set-type "$change_set_type"
  --template-body "file://${template_file}"
  --capabilities CAPABILITY_NAMED_IAM
)
[[ ${#param_args[@]} -gt 0 ]] && create_args+=(--parameters "${param_args[@]}")

if ! error_output="$(aws cloudformation create-change-set "${create_args[@]}" 2>&1)"; then
  error_output="$(echo "$error_output" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
  echo "ERROR: failed to create change set" >&2
  echo "Reason: $error_output" >&2
  exit 1
fi

echo "Waiting for change set to finish computing..."
# Don't let `set -e` kill the script here — a change set with zero diffs
# reports FAILED, which is an expected outcome we handle below, not an error.
aws cloudformation wait change-set-create-complete \
  --stack-name "$stack_name" \
  --change-set-name "$change_set_name" 2>/dev/null || true

status="$(aws cloudformation describe-change-set \
  --stack-name "$stack_name" --change-set-name "$change_set_name" \
  --query "Status" --output text)"

if [[ "$status" == "FAILED" ]]; then
  reason="$(aws cloudformation describe-change-set \
    --stack-name "$stack_name" --change-set-name "$change_set_name" \
    --query "StatusReason" --output text)"

  aws cloudformation delete-change-set \
    --stack-name "$stack_name" --change-set-name "$change_set_name" 2>/dev/null || true

  if [[ "$reason" == *"didn't contain changes"* || "$reason" == *"No updates"* ]]; then
    echo "No changes detected — '$stack_name' is already up to date."
    exit 0
  else
    echo "ERROR: change set failed" >&2
    echo "Reason: $reason" >&2
    exit 1
  fi
fi

echo ""
echo "=== Proposed changes for '$stack_name' ==="
aws cloudformation describe-change-set \
  --stack-name "$stack_name" \
  --change-set-name "$change_set_name" \
  --query "Changes[].ResourceChange.{Action:Action,Resource:LogicalResourceId,Type:ResourceType,Replacement:Replacement}" \
  --output table
echo ""

if [[ "$auto_approve" == false ]]; then
  read -r -p "Apply these changes? [y/N] " reply
else
  reply="y"
fi

if [[ "$reply" =~ ^[Yy]$ ]]; then
  echo "Executing change set..."
  if ! error_output="$(aws cloudformation execute-change-set \
    --stack-name "$stack_name" --change-set-name "$change_set_name" 2>&1)"; then
    error_output="$(echo "$error_output" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
    echo "ERROR: failed to execute change set" >&2
    echo "Reason: $error_output" >&2
    exit 1
  fi

  echo "Waiting for stack operation to complete..."
  if [[ "$change_set_type" == "CREATE" ]]; then
    waiter="stack-create-complete"
  else
    waiter="stack-update-complete"
  fi

  if ! error_output="$(aws cloudformation wait "$waiter" --stack-name "$stack_name" 2>&1)"; then
    error_output="$(echo "$error_output" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
    echo "ERROR: stack operation did not complete successfully" >&2
    echo "Reason: $error_output" >&2
    exit 1
  fi

  echo ""
  echo "Deployment complete. Stack outputs:"
  aws cloudformation describe-stacks \
    --stack-name "$stack_name" --query "Stacks[0].Outputs" --output table
else
  echo "Aborted — cleaning up change set. No changes were applied."
  aws cloudformation delete-change-set \
    --stack-name "$stack_name" --change-set-name "$change_set_name"

  # A CREATE-type change set on a brand-new stack leaves behind an empty
  # stack shell in REVIEW_IN_PROGRESS state. Clean that up too, or it lingers.
  if [[ "$change_set_type" == "CREATE" ]]; then
    aws cloudformation delete-stack --stack-name "$stack_name"
  fi
fi